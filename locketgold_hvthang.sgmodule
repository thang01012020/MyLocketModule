#!name=Locket Gold Víp Pờ Rồ
#!desc=Crack By HVThang

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, firebaseremoteconfigrealtime.googleapis.com, us-central1-locket-4252a.cloudfunctions.net

[Script]
# 1. Tùy chỉnh Feature, Video 45s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig(realtime)?\.googleapis\.com\/.*, script-path=https://raw.githubusercontent.com/thang01012020/MyLocketModule/main/scripts/locket.js, requires-body=true, max-size=524288, timeout=60

# 1.1 Danh sách filter gốc cho Camera Filter Sheet
locket_filters = type=http-request, pattern=^https?:\/\/us-central1-locket-4252a\.cloudfunctions\.net\/.*, binary-mode=1, max-size=0, script-path=https://raw.githubusercontent.com/thang01012020/MyLocketModule/main/scripts/locket.js, timeout=60

# 2. Xóa ETag Header chống dính Cache (by HVThang)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/thang01012020/MyLocketModule/main/scripts/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 29/10/2026 (by HVThang)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/thang01012020/MyLocketModule/main/scripts/locket_sub.js, requires-body=true, max-size=-1, timeout=60
